# Configuração do SERVIDOR; copie para .env na raiz. Nunca versione credenciais.
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
DEFAULT_LANGUAGE=br
TZ=America/Campo_Grande
COOKIE_SECURE=false
# Personalize antes do primeiro início. ADMIN_* só cria conta em banco vazio.
ADMIN_EMAIL=admin@familialubian.local
ADMIN_PASSWORD=
# Em HTTPS público: HOST=0.0.0.0, COOKIE_SECURE=true e APP_URL=https://seu-endereco
# Conta já existente: TREK_SETUP_EMAIL e TREK_SETUP_PASSWORD para a carga inicial.
# Vercel somente: VITE_WS_URL=https://excurs-o-ms.onrender.com (origem, sem /ws)
